# Backend API Configuration
# For local development (Admin panel): http://localhost:6001
# For Android device: http://<YOUR_COMPUTER_LAN_IP>:6001 (e.g., http://192.168.1.100:6001)
# For iOS simulator: http://localhost:6001
# For physical Android device connected to Windows PC: http://<WINDOWS_LAN_IP>:6001
EXPO_PUBLIC_API_URL=http://localhost:6001

# API Timeout (in milliseconds)
EXPO_PUBLIC_API_TIMEOUT=30000
